# Entra ID / Azure AD test creds (template). Copy to .env.entra.
# Enable the connector on the stack: npm run start:entra
# EXPECTED_ROLE = the role the account's Azure group maps to (see repo-root .env.entra).
E2E_ENTRA_USERNAME=<user@tenant>
E2E_ENTRA_PASSWORD=<password>
E2E_ENTRA_EXPECTED_ROLE=role.researcher.demo
