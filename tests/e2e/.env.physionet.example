# PhysioNet test creds (template). Copy to .env.physionet.
# Enable the connector on the stack: npm run start:physionet
# PHYSIONET_UPSTREAM: `mock` (default, built-in mock on :8000) or `real` (physionet-build).
PHYSIONET_UPSTREAM=mock
E2E_PHYSIONET_USERNAME=<user>
E2E_PHYSIONET_PASSWORD=<password>
E2E_PHYSIONET_EXPECTED_ROLE=role.researcher.demo
