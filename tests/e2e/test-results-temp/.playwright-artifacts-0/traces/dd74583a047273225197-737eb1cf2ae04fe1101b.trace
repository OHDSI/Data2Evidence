;\n  height: 20px;\n}\n.alp-alert--error {\n  background-color: #fdeded;\n}\n.alp-alert--error .alp-alert__icon {\n  color: var(--color-feedback-alarm, #d53939);\n}\n.alp-alert--warning {\n  background-color: #fff4e5;\n}\n.alp-alert--warning .alp-alert__icon {\n  color: #f89c0e;\n}\n.alp-alert--success {\n  background-color: #e1fff6;\n}\n.alp-alert--success .alp-alert__icon {\n  color: var(--color-feedback-success, #00855f);\n}\n.alp-alert--info {\n  background-color: #e5e6f2;\n}\n.alp-alert--info .alp-alert__icon {\n  color: var(--color-primary, #000080);\n}\n.alp-alert--multiline {\n  align-items: flex-start;\n}\n.alp-alert--multiline .alp-alert__icon {\n  height: 24px;\n}\n.alp-alert--banner {\n  width: 100%;\n  border-radius: 0;\n}\n.alp-alert--banner.alp-alert--inline {\n  border-radius: 8px;\n}\n.alp-alert--toast {\n  position: fixed;\n  top: var(--alp-alert-toast-top, 68px);\n  right: var(--alp-alert-toast-right, 16px);\n  z-index: 5;\n  width: auto;\n  min-width: 380px;\n  max-width: 420px;\n  border-radius: 8px;\n  box-shadow: var(--shadow-m, 0 3px 12px 0 rgba(0, 0, 0, 0.08));\n  animation: alp-alert-toast-in 220ms ease-out;\n}\n.alp-alert--toast.alp-alert--leaving {\n  animation: alp-alert-toast-out 200ms ease-in forwards;\n}\n\n@keyframes alp-alert-toast-in {\n  from {\n    opacity: 0;\n    transform: translateX(16px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n@keyframes alp-alert-toast-out {\n  from {\n    opacity: 1;\n    transform: translateX(0);\n  }\n  to {\n    opacity: 0;\n    transform: translateX(16px);\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .alp-alert--toast,\n  .alp-alert--toast.alp-alert--leaving {\n    animation: none;\n  }\n}"],["STYLE",{},".alp-button__container {\n  position: relative;\n  display: inline-block;\n}\n.alp-button__container.button--block {\n  display: block;\n}\n.alp-button__container.button--block .alp-button {\n  width: 100%;\n}\n.alp-button__container .alp-button {\n  font-size: 1