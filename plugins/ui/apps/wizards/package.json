{
  "name": "wizards",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "concurrently --kill-others \"bun build:watch\" \"bun preview\"",
    "build": "vite build",
    "build:dev": "vite build --mode=development",
    "build:watch": "vite build --mode=development --watch",
    "preview": "vite preview --mode=development",
    "test": "vitest run",
    "lint": "eslint src --ext js,ts,tsx",
    "format": "prettier --write .",
    "check-format": "prettier --check ."
  },
  "dependencies": {
    "@emotion/react": "^11.9.0",
    "@emotion/styled": "^11.8.1",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@mui/material": "^5.8.3",
    "@ohdsi/atlas-ui": "0.1.0-20260721210553-c51900d",
    "axios": "^1.13.4",
    "pako": "^2.1.0",
    "pinia": "^2.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "single-spa": "^6.0.3",
    "single-spa-react": "^6.0.2",
    "single-spa-vue": "^3.0.1",
    "vue": "^3.5.22",
    "vuetify": "^3.12.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.2",
    "vite": "^6.4.2",
    "vite-plugin-css-injected-by-js": "^3.5.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^2.2.12"
