{
  "name": "@d2e/ui-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "D2E React + MUI component library",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css",
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts && git diff --exit-code src/tokens/tokens.css",
    "test": "vitest run",
    "lint": "prettier --write .",
    "build": "vite build --config vite.config.lib.ts && bun run build:types",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist/types -p tsconfig.build.json",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "peerDependencies": {
    "@emotion/react": "^11.9.0",
    "@emotion/styled": "^11.8.1",
    "@mui/icons-material": "^5.8.3",
    "@mui/material": "^5.8.3",
    "@mui/x-date-pickers": "^6.19.2",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.9.0",
    "@emotion/styled": "^11.8.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "storybook": "^10.6.1",
    "@mui/icons-material": "^5.8.3",
    "@mui/material": "^5.8.3",
    "@mui/x-date-pickers": "^6.19.2",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.77.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.0.18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts"
}
