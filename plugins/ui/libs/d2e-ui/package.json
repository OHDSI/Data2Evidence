{
  "name": "@d2e/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "D2E Vue 3 + Vuetify component library",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "tokens:build": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts && git diff --exit-code src/tokens/tokens.css",
    "ui:dev": "histoire dev",
    "ui:build": "histoire build",
    "test": "vitest run",
    "lint": "prettier --write ."
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vuetify": "^3.12.0"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "^1.0.0-beta.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "histoire": "^1.0.0-beta.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.0.18",
    "vue": "^3.5.17",
    "vuetify": "3.12.0"
  }
}
