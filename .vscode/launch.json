{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "trex",
      "port": 9229,
      "request": "attach",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "localRoot": "${workspaceFolder}/services/trex",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/service/trex**",
        "${workspaceFolder}/plugins/functions/**",
        "!**/node_modules/**"
      ],
      "type": "node"
    },
    {
      "name": "hades-local",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 9234
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/flows",
          "remoteRoot": "./flows"
        }
      ]
    }
  ]
}