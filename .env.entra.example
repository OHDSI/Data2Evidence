# Entra ID / Azure AD connector overlay (template). Copy to .env.entra, then: npm run start:entra
IDP__RELYING_PARTY=azure
ENTRA__TENANT_ID=<tenant-guid>
ENTRA__CLIENT_ID=<app-id>
ENTRA__CLIENT_SECRET=<secret>
LOGTO__CONNECTOR_CONFIG={ "id": "y9nq6f91yeg19kwt1x6xz","connectorId": "azuread-alp", "config": { "clientId": "<app-id>", "tenantId": "<tenant-guid>", "clientSecret": "<secret>", "cloudInstance": "https://login.microsoftonline.com", "scopes": "openid,profile,email,offline_access"}, "syncProfile": true}
LOGTO__SOCIAL_SIGNIN_TARGETS=azuread-alp
LOGTO__ENABLE_REGISTRATION=true
LOGTO_ROLES_AZ_GROUPS_MAPPING={"role.researcher.demo":"<azure-group-guid>"}
IDP__FETCH_USER_INFO_TYPE=logto
