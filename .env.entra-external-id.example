# Entra External ID (CIAM) connector overlay (template). Copy to .env.entra-external-id, then:
#   npm run start:entra-external-id
ENTRA_EXTID__CLIENT_ID=<app-id>
ENTRA_EXTID__CLIENT_SECRET=<secret>
ENTRA_EXTID__TENANT_SUBDOMAIN=<subdomain>
ENTRA_EXTID__TENANT_ID=<tenant-guid>
LOGTO__CONNECTOR_CONFIG={ "id": "9mf50ajua2ye7pydd2nxk", "connectorId": "entra-external-id-alp", "config": { "clientId": "<app-id>", "clientSecret": "<secret>", "tenantSubdomain": "<subdomain>", "tenantId": "<tenant-guid>", "scopes": "openid,profile,email,offline_access"}, "syncProfile": true}
LOGTO__SOCIAL_SIGNIN_TARGETS=entra-external-id-alp
# Lets user-mgmt create the user record on first federated sign-in (else sync returns 500).
IDP__AUTO_PROVISION_USERS=true
LOGTO__ENABLE_REGISTRATION=true
