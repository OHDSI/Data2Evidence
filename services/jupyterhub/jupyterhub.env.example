# Optional hub tuning. Copy to services/jupyterhub/.env and change what you
# need; the hub also starts without it. Never commit the populated copy.
#
# Only values the overlay does not set itself belong here. Anything listed
# under the hub's `environment:` in docker-compose-jupyterhub.yml wins over
# this file, so putting it here has no effect. Set those in
# .env.jupyterhub-local at the repository root instead, then recreate the hub:
#   LOGTO__JUPYTERHUB__CLIENT_ID, LOGTO__JUPYTERHUB__CLIENT_SECRET,
#   JUPYTERHUB__PUBLIC_URL, JUPYTERHUB_NOTEBOOK_IMAGE,
#   JUPYTER_DB_ENABLED, JUPYTER_DB_ROLE_MAP, JUPYTER_DB_LEASE_SECONDS,
#   JUPYTER_DB_BROKER_PASSWORD

# Required in practice. Encrypts the stored Logto tokens (auth_state). Without
# it no tokens are kept, so notebooks get no database login.
# Generate with: openssl rand -hex 32
JUPYTERHUB_CRYPT_KEY=replace-with-32-byte-hex

# Per-user notebook limits and hub log level.
JUPYTERHUB_USER_MEM_LIMIT=1G
JUPYTERHUB_USER_CPU_LIMIT=1
JUPYTERHUB_LOG_LEVEL=INFO

# Logout. true stops the user's notebook container on logout; files stay in
# the user's volume.
JUPYTERHUB_SHUTDOWN_ON_LOGOUT=true

# Optional. Set, logout also passes through Logto's end-session page and then
# returns to the hub login page. It does not end the Logto account session, so
# the next login may not ask for a password. The return URL must be registered
# in the Logto app's post sign-out redirect URIs.
LOGTO_END_SESSION_URL=https://localhost/oidc/session/end
JUPYTERHUB_POST_LOGOUT_REDIRECT_URL=http://localhost:8000/hub/login

# Rarely changed. Defaults are already correct for D2E.
# LOGTO_RESOURCE=https://alp-default   # API resource the role scopes belong to
# LOGTO_USERNAME_CLAIM=username        # Logto leaves preferred_username empty
# LOGTO_EXTRA_SCOPES=                  # extra D2E scopes to request, space separated
