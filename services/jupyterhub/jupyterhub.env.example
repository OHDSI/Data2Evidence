# Optional. Copy to services/jupyterhub/.env only if you need to change one of
# these; the hub starts without this file. Never commit the populated copy.
#
# The OIDC client id and secret, the callback and the Logto endpoints are NOT
# here: docker-compose-jupyterhub.yml derives them from the same variables that
# register the application, so they cannot drift apart. Set
# LOGTO__JUPYTERHUB__CLIENT_SECRET in the stack's own .env instead.

# openssl rand -hex 32. Persists auth_state, which keeps the Logto tokens for a
# notebook that later needs to call D2E APIs as the logged-in user.
JUPYTERHUB_CRYPT_KEY=replace-with-32-byte-hex

# The API resource the role scope belongs to. Must match LOGTO__RESOURCE.
LOGTO_RESOURCE=https://alp-default

# Logto 1.23 advertises preferred_username but never populates it, and
# email/name are null for the seeded admin user. Leave this alone.
LOGTO_USERNAME_CLAIM=username

# Notebooks join this network and nothing else. Keep it separate from the D2E
# network: user code in a notebook must not reach Postgres, Redis or Logto's
# management API.
DOCKER_NETWORK_NAME=jupyterhub-notebooks

JUPYTERHUB_NOTEBOOK_IMAGE=quay.io/jupyterhub/singleuser:5.4.2
JUPYTERHUB_USER_MEM_LIMIT=1G
JUPYTERHUB_USER_CPU_LIMIT=1
JUPYTERHUB_LOG_LEVEL=INFO

# Optional. Unset, JupyterHub's logout clears only the hub cookie. Set, logout
# also goes through Logto's end_session endpoint, which drops this client's
# grant (the consent screen reappears on the next login) but does NOT end the
# Logto account session, so the next login still needs no password: ending that
# needs an id_token_hint, which a static logout_redirect_url cannot carry.
# The post-logout URL must be registered in the Logto app's postLogoutRedirectUris.
LOGTO_END_SESSION_URL=https://localhost/oidc/session/end
JUPYTERHUB_POST_LOGOUT_REDIRECT_URL=http://localhost:8000/hub/login
JUPYTERHUB_SHUTDOWN_ON_LOGOUT=true
